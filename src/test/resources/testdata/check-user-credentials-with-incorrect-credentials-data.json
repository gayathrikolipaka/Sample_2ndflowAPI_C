{
  "testCaseId": "TCD_FT_09_NEG",
  "testCaseName": "Check user credentials with incorrect credentials",
  "endpoint": "/Account/v1/Authorized",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json"
  },
  "testData": [
    {
      "description": "Invalid username and invalid password",
      "requestBody": {
        "userName": "invalidUser",
        "password": "invalidPass123"
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    },
    {
      "description": "Valid username and invalid password",
      "requestBody": {
        "userName": "existingUser",
        "password": "wrongPassword!"
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    },
    {
      "description": "Invalid username and valid password format",
      "requestBody": {
        "userName": "notAUser",
        "password": "ValidPassw0rd!"
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    },
    {
      "description": "Empty username and password",
      "requestBody": {
        "userName": "",
        "password": ""
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    },
    {
      "description": "Null username and password",
      "requestBody": {
        "userName": null,
        "password": null
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    },
    {
      "description": "Username with SQL injection attempt",
      "requestBody": {
        "userName": "' OR 1=1;--",
        "password": "anyPassword"
      },
      "expectedResponse": {
        "statusCode": 401,
        "bodyContains": ["Unauthorized", "User not authorized!"]
      }
    }
  ]
}
